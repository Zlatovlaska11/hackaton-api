generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
}

model Users {
  userId                 Int             @id @default(autoincrement())
  username               String          @unique
  password               String
  petType                String?
  petName                String?
  petTypeOption          PetType?        @relation(fields: [petType], references: [code])
  sentMessages           Message[]       @relation("sentMessages")
  receivedMessages       Message[]       @relation("receivedMessages")
  sentFriendRequests     FriendRequest[] @relation("sentFriendRequests")
  receivedFriendRequests FriendRequest[] @relation("receivedFriendRequests")
}

model PetType {
  code  String  @id
  users Users[]
}

model Message {
  id         Int      @id @default(autoincrement())
  text       String
  sender     Users    @relation("sentMessages", fields: [senderId], references: [userId])
  senderId   Int
  receiver   Users    @relation("receivedMessages", fields: [receiverId], references: [userId])
  receiverId Int
  createdAt  DateTime @default(now())
}

model FriendRequest {
  id          Int                 @id @default(autoincrement())
  requester   Users               @relation("sentFriendRequests", fields: [requesterId], references: [userId])
  requesterId Int
  receiver    Users               @relation("receivedFriendRequests", fields: [receiverId], references: [userId])
  receiverId  Int
  pairUserAId Int
  pairUserBId Int
  status      FriendRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  acceptedAt  DateTime?

  @@unique([pairUserAId, pairUserBId])
  @@index([requesterId, status])
  @@index([receiverId, status])
}
