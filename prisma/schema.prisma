// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
}

enum Behavior {
  Tree
  Water
  City

  @@map("behavior")
}

model Users {
  userId                 Int             @id @default(autoincrement())
  username               String          @unique
  password               String
  petType                String?
  petName                String?
  petTypeOption          PetType?        @relation(fields: [petType], references: [code])
  sentMessages           Message[]       @relation("sentMessages")
  receivedMessages       Message[]       @relation("receivedMessages")
  sentFriendRequests     FriendRequest[] @relation("sentFriendRequests")
  receivedFriendRequests FriendRequest[] @relation("receivedFriendRequests")
  routes                 Route[]
  pokemon                Pokemon[]
}

model PetType {
  code  String  @id
  users Users[]
}

model Message {
  id         Int      @id @default(autoincrement())
  text       String
  sender     Users    @relation("sentMessages", fields: [senderId], references: [userId])
  senderId   Int
  receiver   Users    @relation("receivedMessages", fields: [receiverId], references: [userId])
  receiverId Int
  createdAt  DateTime @default(now())
}

model FriendRequest {
  id          Int                 @id @default(autoincrement())
  requester   Users               @relation("sentFriendRequests", fields: [requesterId], references: [userId])
  requesterId Int
  receiver    Users               @relation("receivedFriendRequests", fields: [receiverId], references: [userId])
  receiverId  Int
  pairUserAId Int
  pairUserBId Int
  status      FriendRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  acceptedAt  DateTime?

  @@unique([pairUserAId, pairUserBId])
  @@index([requesterId, status])
  @@index([receiverId, status])
}

model Pokemon {
  id       Int      @id @default(autoincrement())
  userId   Int      @map("user_id")
  name     String
  behavior Behavior
  user     Users    @relation(fields: [userId], references: [userId], onDelete: Cascade)
  routes   Route[]

  @@index([userId])
  @@map("pokemon")
}

model Route {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  pokemonId  Int      @map("pokemon_id")
  ended      Boolean  @default(false)
  inProgress Boolean  @default(false) @map("in_progress")
  donePercent Float   @default(0) @map("done_percent")
  createdAt  DateTime @default(now()) @map("created_at")
  startedAt  DateTime? @map("started_at")
  endedAt    DateTime? @map("ended_at")
  user       Users    @relation(fields: [userId], references: [userId], onDelete: Cascade)
  pokemon    Pokemon  @relation(fields: [pokemonId], references: [id], onDelete: Cascade)
  points     Point[]

  @@index([userId, inProgress])
  @@index([pokemonId])
  @@map("routes")
}

model Point {
  id              Int    @id @default(autoincrement())
  lat             Float
  lng             Float
  visited         Boolean @default(false)
  previousPointId Int?   @map("previous_point_id")
  nextPointId     Int?   @map("next_point_id")
  routeId         Int    @map("route_id")
  route           Route  @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@index([routeId])
  @@map("points")
}
